{
  "name": "discord-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord-Bot mit Webpanel fuer automatische Nachrichten, Vorlagen und Aktionsleisten",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/start.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/start.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.mjs\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "busboy": "^1.6.0",
    "discord.js": "^14.27.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1"
  }
}
