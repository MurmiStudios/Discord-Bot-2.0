# Diese Datei ist eine Vorlage. `npm run setup` schreibt die echte .env —
# von Hand ausfuellen muss man hier nichts.

# --- Pflicht -----------------------------------------------------------------
# Entwicklerportal → Application → Bot → Reset Token
DISCORD_TOKEN=
# Entwicklerportal → Application → OAuth2 → Client ID / Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord → Rechtsklick auf den Server → Server-ID kopieren
GUILD_ID=
# Discord → Rechtsklick auf dein Profil → Benutzer-ID kopieren
OWNER_DISCORD_ID=
# Adresse, unter der das Panel erreichbar ist. Ohne Domain die Server-IP.
PANEL_URL=http://127.0.0.1:3000
# Wird vom Setup zufaellig erzeugt, mindestens 32 Zeichen.
SESSION_SECRET=

# --- Optional, mit Vorgabewerten ---------------------------------------------
PORT=3000
# Hoechstzahl Empfaenger je Massenversand.
DM_MAX_RECIPIENTS=100
# Pause zwischen zwei Direktnachrichten in Millisekunden.
DM_DELAY_MS=1200
# Groesse und laengste Kante fuer hochgeladene Hintergrundbilder.
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_EDGE=4096
# Auf 1 setzen, sobald das Panel hinter einem Reverse Proxy mit HTTPS steht.
# Bei einer https-PANEL_URL ist das Pflicht, sonst bricht der Start ab.
TRUST_PROXY=0
